# Copier en .env pour personnaliser. Tout a une valeur par défaut en local.

ENVIRONMENT=local
# SHA git du code, injecté par la CI dans l'image Docker
APP_REVISION=dev
LOG_LEVEL=INFO
# text ou json
LOG_FORMAT=text

MLFLOW_TRACKING_URI=http://localhost:7281
MLFLOW_EXPERIMENT_NAME=bikeshare-demand
# modèle du registre MLflow et alias suivi par l'API : déplacer l'alias change le modèle servi
MODEL_NAME=bikeshare-demand
MODEL_ALIAS=champion

# ports publiés sur la machine, à changer s'ils sont déjà pris
MLFLOW_PORT=7281
PREFECT_PORT=4200
POSTGRES_PORT=5432
ALERT_SINK_PORT=8002

# mots de passe de démonstration : stack locale uniquement
POSTGRES_PASSWORD=bikeshare-local-postgres
# api_writer : ajoute les traces de l'API, sans pouvoir les modifier
API_DB_PASSWORD=bikeshare-local-api
# pipeline_writer : suivi du pipeline
OPS_DB_PASSWORD=bikeshare-local-pipeline
# grafana_reader : lecture seule
GRAFANA_DB_PASSWORD=bikeshare-local-grafana

# secondes entre deux exécutions planifiées (un mois de données rejoué à chaque fois)
PIPELINE_SCHEDULE_SECONDS=600
# webhook externe (Slack, Discord...) vers lequel relayer les alertes, vide = désactivé
ALERT_FORWARD_URL=
