# Copier en .env pour personnaliser. Tout a une valeur par défaut en local.

ENVIRONMENT=local
LOG_LEVEL=INFO
# text ou json
LOG_FORMAT=text

# adresse de MLflow vue de la machine hôte (les conteneurs utilisent http://mlflow:7281)
MLFLOW_TRACKING_URI=http://localhost:7281
MLFLOW_EXPERIMENT_NAME=bikeshare-demand
# modèle du registre MLflow et alias suivi par l'API : déplacer l'alias change le modèle servi
MODEL_NAME=bikeshare-demand
MODEL_ALIAS=champion

# ports publiés sur la machine, à changer s'ils sont déjà pris (la doc et le Makefile visent ceux par défaut)
MLFLOW_PORT=7281
PREFECT_PORT=4200
POSTGRES_PORT=5432
ALERT_SINK_PORT=8002

# mots de passe de démonstration : stack locale uniquement
POSTGRES_PASSWORD=bikeshare-local-postgres
# api_writer : ajoute les traces de l'API, sans pouvoir les modifier
API_DB_PASSWORD=bikeshare-local-api
# pipeline_writer : suivi du pipeline
OPS_DB_PASSWORD=bikeshare-local-pipeline
# grafana_reader : lecture seule
GRAFANA_DB_PASSWORD=bikeshare-local-grafana

# secondes entre deux exécutions planifiées (un mois de données rejoué à chaque fois)
PIPELINE_SCHEDULE_SECONDS=600
# webhook externe (Slack, Discord...) vers lequel relayer les alertes, vide = désactivé
ALERT_FORWARD_URL=

API_PORT=8001
# processus uvicorn, chacun charge son modèle (environ 220 Mo)
API_WORKERS=1
# threads OpenMP de scikit-learn par worker : le parallélisme vient des workers
API_OMP_THREADS=1
# limites du conteneur de l'API, à faire varier pour les tests de charge
API_CPUS=1.0
API_MEMORY=768M
# connexions PostgreSQL par worker
API_DB_POOL_MAX=5
# délai max avant qu'un worker suive un changement de champion
MODEL_REFRESH_SECONDS=30
HEARTBEAT_SECONDS=15
# exigé par POST /admin/model/refresh
ADMIN_TOKEN=bikeshare-local-admin-token

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=bikeshare-local-admin
