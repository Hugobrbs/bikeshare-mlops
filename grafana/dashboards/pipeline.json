    {
      "type": "timeseries",
      "title": "MAE sur le jeu de test, par exécution",
      "description": "Les trois modèles sont mesurés sur le même jeu de test.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bikeshare-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bikeshare-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT started_at AS time, (metrics->>'mae')::float AS candidat, (metrics->>'baseline_mae')::float AS baseline, (metrics->>'champion_mae')::float AS \"champion en place\" FROM ops.pipeline_runs WHERE $__timeFilter(started_at) AND metrics IS NOT NULL ORDER BY 1"
        }
