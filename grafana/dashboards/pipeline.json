    {
      "type": "table",
      "title": "Exécutions du pipeline",
      "description": "resultat : promoted, champion_kept, rejected, no_new_data, invalid_data ou error.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bikeshare-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bikeshare-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT started_at AS debut, round(extract(epoch FROM ended_at - started_at)::numeric, 1) AS duree_s, status AS statut, outcome AS resultat, array_to_string(batch_ids, ', ') AS lots, model_version AS version, round((metrics->>'mae')::numeric, 1) AS mae, left(error, 160) AS erreur FROM ops.pipeline_runs WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      }
